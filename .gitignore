# ─────────────────────────────────────────────────────────────────────────────
#  eCommerce Go — .gitignore
#
#  Purpose: keep the repository small and safe while still allowing a full
#  rollback with `git reset --hard baseline-v0`.
#
#  IMPORTANT: everything listed here is also protected from `git clean -fd`,
#  because git clean does not remove ignored files unless -x is passed.
#  That is intentional: vendor/, node_modules/ and uploaded media must never
#  be deleted by an emergency rollback.
# ─────────────────────────────────────────────────────────────────────────────

# ── Dependencies (restorable: composer install / npm install) ────────────────
/vendor
/node_modules

# ── Secrets — NEVER commit these ─────────────────────────────────────────────
.env
.env.backup
.env.production
.env.local
/auth.json

# ── Build output (regenerated by: npm run build) ─────────────────────────────
/public/build
/public/hot

# ── Laravel storage symlink (recreate with: php artisan storage:link) ────────
/public/storage

# ── Runtime / cache / logs ───────────────────────────────────────────────────
/storage/*.key
/storage/pail
/storage/debugbar
/storage/logs/*
!/storage/logs/.gitignore
/storage/framework/cache/*
!/storage/framework/cache/.gitignore
/storage/framework/sessions/*
!/storage/framework/sessions/.gitignore
/storage/framework/views/*
!/storage/framework/views/.gitignore
/storage/framework/testing/*
!/storage/framework/testing/.gitignore
/bootstrap/cache/*
!/bootstrap/cache/.gitignore

# ── User-uploaded media (not code — must survive a rollback) ─────────────────
/storage/app/public/uploads
/storage/uploads
/uploads

# ── Tests ───────────────────────────────────────────────────────────────────
/.phpunit.cache
.phpunit.result.cache

# ── SPA/PWA project working files ────────────────────────────────────────────
# Machine-local crash journal — see .ai/PROJECT_CONTEXT.md section 2.1
/.ai/state
# Browser-test screenshots: large binaries, local evidence only.
# Ignored so they are never wiped by `git clean -fd`, but the folder itself is
# kept in the repo so models always have somewhere to write.
/.ai/screenshots/*
!/.ai/screenshots/.gitkeep

# ── Editors / OS ────────────────────────────────────────────────────────────
/.idea
/.vscode
/.fleet
/.nova
/.zed
/.antigravity
.phpactor.json
Homestead.json
Homestead.yaml
npm-debug.log
yarn-error.log
*.log
.DS_Store
Thumbs.db
desktop.ini

dump.rdb
.alpme/

# Local theme folder backup (THEME-BACKUP, 2026-10-10) � restore source, never commit, protects from git clean
themes_backup/
