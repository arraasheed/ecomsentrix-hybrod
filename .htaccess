<IfModule mod_rewrite.c>
    <IfModule mod_negotiation.c>
        Options -MultiViews -Indexes
    </IfModule>

    <Files .env>
        Order Allow,Deny
        Deny from all
    </Files>

    RewriteEngine On

    # Handle Authorization Header
    RewriteCond %{HTTP:Authorization} .
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

    # Redirect Trailing Slashes If Not A Folder...
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_URI} (.+)/$
    RewriteRule ^ %1 [L,R=301]

    # Handle Front Controller...
    RewriteCond %{REQUEST_URI} !(\.css|\.js|\.png|\.jpg|\.jpeg|\.gif|robots\.txt|\.ico|\.woff|\.woff2|.ttf|\.svg|\.html)$ [NC]
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^ index.php [L]

    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_URI} ^/packages/workdo/
    RewriteRule ^packages/workdo/(.*)$ packages/workdo/$1 [L,NC]

    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_URI} !^/public/
    RewriteRule ^sw\.js$ public/sw.js [L,NC]

    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_URI} !^/public/
    RewriteRule ^offline\.html$ public/offline.html [L,NC]

    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_URI} !^/public/
    RewriteRule ^(build|css|assets|market_assets|images|landing|uploads|storage|installer|js|vendor)/(.*)$ public/$1/$2 [L,NC]
</IfModule>

# ============================================================================
# BEGIN Cache-Control headers (P5 fix — mtime-based asset versioning)
# ============================================================================
# With asset_v() replacing ?v=time(), static asset URLs now stay stable across
# requests and only change when the file itself changes. Browsers can finally
# cache them; these headers say for how long.
#
# HTML is deliberately absent: Laravel already sends
# "Cache-Control: no-cache, private" on every rendered page, so adding a rule
# here would only risk overriding it.
#
# KILL-SWITCH: delete or comment out everything between BEGIN and END to
# restore the server's previous behaviour (Last-Modified + ETag only, browser
# heuristics decide). Nothing else in the app depends on this block.
# ============================================================================

<IfModule mod_setenvif.c>
    # Vite's build output is content-hashed (app-Cs0QkU1O.js), so its URL
    # changes whenever the bytes change. Flag it for the 'immutable' rule
    # below. Matched as a substring because the root RewriteRule turns
    # /build/... into /public/build/... before headers are applied.
    SetEnvIf Request_URI "/build/" IMMUTABLE_ASSET
</IfModule>

<IfModule mod_headers.c>
    # Fonts: 1 year. They are versioned by filename or never change.
    <FilesMatch "\.(woff|woff2|ttf|eot)$">
        Header set Cache-Control "max-age=31536000, public" env=!IMMUTABLE_ASSET
    </FilesMatch>

    # Images and icons: 30 days. Uploaded logos can be replaced, and get_file_v()
    # already changes their URL when that happens.
    <FilesMatch "\.(jpg|jpeg|png|gif|ico|webp|svg)$">
        Header set Cache-Control "max-age=2592000, public" env=!IMMUTABLE_ASSET
    </FilesMatch>

    # CSS/JS outside /build/: 7 days. Not every one of them goes through
    # asset_v() yet, so a shorter window avoids serving stale code after an
    # upstream WorkDo update drops in new files.
    <FilesMatch "\.(css|js)$">
        Header set Cache-Control "max-age=604800, public" env=!IMMUTABLE_ASSET
    </FilesMatch>

    # Everything under /build/ — hashed filename, safe to cache forever.
    # This block sits last on purpose: 'Header set' replaces whatever an
    # earlier FilesMatch set, so the specific rule has to win over the generic.
    <FilesMatch "\.(css|js|woff|woff2|ttf|eot|svg|png|jpg|jpeg|gif|webp)$">
        Header set Cache-Control "max-age=31536000, immutable" env=IMMUTABLE_ASSET
    </FilesMatch>
</IfModule>

# ============================================================================
# END Cache-Control headers
# ============================================================================
